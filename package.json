{
  "name": "hq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "tsc -p shared && tsc -p server --noEmit && tsc -p web --noEmit && tsc -p e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "skills:add": "node scripts/add-skill.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
